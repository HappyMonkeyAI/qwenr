# Copy to .env (gitignored). Loaded automatically next to config.yaml.
# Token Plan Individual key — starts with sk-sp-
QWEN_TOKEN_PLAN_API_KEY=
# Optional Singapore PAYG key for free-quota lane — typically sk-ws-
QWEN_PAYG_API_KEY=
# Optional overrides:
# QWEN_TOKEN_PLAN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
# QWEN_PAYG_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
